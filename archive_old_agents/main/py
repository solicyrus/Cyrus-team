import os
from crewai import Agent, Task, Crew, Process
from textwrap import dedent

# قرار دادن کلید دسترسی هوش مصنوعی
os.environ["OPENAI_API_KEY"] = "YOUR_OPENAI_API_KEY"

# ==========================================
# بخش اول: تعریف ایجنت‌ها (نمونه‌ای از ۴۰ ایجنت)
# ==========================================

# ایجنت ۱: معمار اپلیکیشن (از دپارتمان توسعه)
app_architect = Agent(
    role='معمار ارشد سیستم‌های هوش مصنوعی',
    goal='طراحی زیرساخت بهینه برای اپلیکیشن‌های چندزبانه و چت‌بوت‌های هوشمند',
    backstory=dedent("""\
        شما یک مهندس نرم‌افزار با تجربه هستید که معماری سیستم‌های پیچیده مبتنی بر API را طراحی می‌کنید.
        دقت شما در پایداری سیستم و مدیریت خطاها (مثل خطاهای 404) بی‌نظیر است."""),
    verbose=True,
    allow_delegation=True # اجازه ارجاع کار به ایجنت‌های دیگر را دارد
)

# ایجنت ۲: مهندس پرامپت ویدیو (از دپارتمان ویدیو)
video_prompt_engineer = Agent(
    role='متخصص تولید ویدیوی هوش مصنوعی',
    goal='تولید پرامپت‌های دقیق برای ساخت صحنه‌های انیمیشنی با ابزارهای پیشرفته',
    backstory=dedent("""\
        شما متخصص کار با مدل‌های زایشی ویدیو هستید و می‌دانید چگونه پرامپت‌هایی بنویسید که
        ثبات کاراکترها و نورپردازی را در طول سکانس‌ها حفظ کند."""),
    verbose=True,
    allow_delegation=False
)

# ایجنت ۳: تحلیل‌گر بازار گردشگری (از دپارتمان تحلیل بازار)
market_analyst = Agent(
    role='تحلیل‌گر ارشد بازار محلی',
    goal='استخراج داده‌های تقاضای سفر و شناسایی بهترین فرصت‌های سرمایه‌گذاری در خدمات',
    backstory=dedent("""\
        شما یک اقتصاددان و تحلیل‌گر داده هستید که بازار گردشگری را رصد می‌کنید
        و می‌توانید روندهای آینده را با دقت بالایی پیش‌بینی کنید."""),
    verbose=True,
    allow_delegation=False
)

# ==========================================
# بخش دوم: تعریف تسک‌ها (وظایف)
# ==========================================

task1 = Task(
    description='یک معماری بک‌اند برای سیستم مسیریابی توریستی طراحی کن که APIهای مختلف را بدون افت سرعت فراخوانی کند.',
    expected_output='مستندات معماری نرم‌افزار شامل نمودار جریان داده‌ها و ساختار دایرکتوری‌ها.',
    agent=app_architect
)

task2 = Task(
    description='یک سناریوی ۳۰ ثانیه‌ای برای یوتیوب شامل پرامپت‌های دقیق صحنه‌به‌صحنه برای تولید ویدیو آماده کن.',
    expected_output='یک فایل متنی شامل دیالوگ‌ها و پرامپت‌های فنی تنظیم دوربین و نور.',
    agent=video_prompt_engineer
)

task3 = Task(
    description='وضعیت تقاضای تورهای طبیعت‌گردی را تحلیل کن و سه نقطه با بالاترین پتانسیل را گزارش بده.',
    expected_output='گزارش تحلیلی ۳ صفحه‌ای با ذکر داده‌های آماری.',
    agent=market_analyst
)

# ==========================================
# بخش سوم: ایجاد Crew (تیم) و اجرای فرآیند
# ==========================================

cyrus_team = Crew(
    agents=[app_architect, video_prompt_engineer, market_analyst], # تمامی ۴۰ ایجنت اینجا لیست می‌شوند
    tasks=[task1, task2, task3], # تمامی وظایف اینجا لیست می‌شوند
    process=Process.hierarchical, # فرآیند سلسله‌مراتبی: یک ایجنت مدیر، بقیه را کنترل می‌کند
    manager_llm="gpt-4o", # مدلی که نقش مدیر تیم را ایفا می‌کند
    verbose=True
)

# شروع به کار تیم
print("تیم سایرس در حال آغاز ماموریت است...")
result = cyrus_team.kickoff()

print("######################")
print("نتیجه نهایی کار تیم:")
print(result)
